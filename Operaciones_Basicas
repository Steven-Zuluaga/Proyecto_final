#Suma
def sumar(a, b):
    return a + b

#Resta
def restar(a, b):
    return a - b

#Multiplicacion
def multiplicar(a, b):
    return a * b

#Divvision
def dividir(a, b):
    if b == 0:
        print(' Error: No se puede dividir entre cero.')
        return None
    return a / b

#Potencia
def potencia(base, exponente):
    if exponente < 0:
        print(' Error: Solo se aceptan exponentes enteros >= 0.')
        return None
    resultado = 1
    for i in range(exponente):
        resultado = resultado * base
    return resultado
